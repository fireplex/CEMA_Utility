- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, num_channels=32, threshold=0.01):\n        gr.sync_block.__init__(\n\
      \            self,\n            name='FHSS Channel Auto-Selector',\n       \
      \     in_sig=[np.complex64] * num_channels,\n            out_sig=[np.complex64]\n\
      \        )\n        self.num_channels = num_channels\n        self.threshold\
      \ = threshold\n        self.active_ch = 0\n\n    def work(self, input_items,\
      \ output_items):\n        # Calculate mean power across current buffer for each\
      \ channel\n        powers = [np.mean(np.abs(input_items[ch])**2) for ch in range(self.num_channels)]\n\
      \        \n        peak_ch = int(np.argmax(powers))\n        if powers[peak_ch]\
      \ > self.threshold:\n            self.active_ch = peak_ch\n\n        # Pass\
      \ active channel's complex IQ stream straight to output\n        output_items[0][:]\
      \ = input_items[self.active_ch][:]\n        return len(output_items[0])"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_channels: '32'
    threshold: '0.001'
  states:
    _io_cache: ('FHSS Channel Auto-Selector', 'blk', [('num_channels', '32'), ('threshold',
      '0.01')], [('0', 'complex', 1), ('1', 'complex', 1), ('2', 'complex', 1), ('3',
      'complex', 1), ('4', 'complex', 1), ('5', 'complex', 1), ('6', 'complex', 1),
      ('7', 'complex', 1), ('8', 'complex', 1), ('9', 'complex', 1), ('10', 'complex',
      1), ('11', 'complex', 1), ('12', 'complex', 1), ('13', 'complex', 1), ('14',
      'complex', 1), ('15', 'complex', 1), ('16', 'complex', 1), ('17', 'complex',
      1), ('18', 'complex', 1), ('19', 'complex', 1), ('20', 'complex', 1), ('21',
      'complex', 1), ('22', 'complex', 1), ('23', 'complex', 1), ('24', 'complex',
      1), ('25', 'complex', 1), ('26', 'complex', 1), ('27', 'complex', 1), ('28',
      'complex', 1), ('29', 'complex', 1), ('30', 'complex', 1), ('31', 'complex',
      1)], [('0', 'complex', 1)], '', ['num_channels', 'threshold'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1256, 668.0]
    rotation: 0
    state: enabled
